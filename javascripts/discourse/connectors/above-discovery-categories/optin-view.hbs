<nav class="optin-view-switcher" aria-label="Ansicht wechseln">
  <a href={{this.standardUrl}} 
     class="optin-view-link {{unless this.showOptinView "active"}}" 
     title="Standard-Ansicht"
     {{action "switchToStandard"}}>
    Standard
  </a>
  <a href={{this.optinUrl}} 
     class="optin-view-link {{if this.showOptinView "active"}}" 
     title="Opt-in-Ansicht"
     {{action "switchToOptin"}}>
    Opt-in
  </a>
</nav>

{{#if this.showOptinView}}
  <div class="optin-grid">
    {{#each this.groupedCategories as |group|}}
      <section class="optin-card" style={{html-safe (concat "border-left-color: #" group.parent.color)}}>
        <div class="optin-card-header">
          {{category-title-link category=group.parent}}
          <OptinNotificationButton @category={{group.parent}} />
        </div>
        
        {{#if group.parent.description}}
          <div class="optin-card-description">
            {{html-safe group.parent.description}}
          </div>
        {{/if}}

        {{#if group.children.length}}
          <div class="optin-subcats-label">
            {{d-icon "chevron-down"}} UNTERKATEGORIEN
          </div>
          <div class="optin-subcats">
            {{#each group.children as |sub|}}
              <span class="optin-chip">
                {{category-title-link category=sub}}
                
                {{#if sub.description}}
                  <span class="optin-info-icon">
                    <svg class="fa d-icon d-icon-info-circle svg-icon svg-node" aria-hidden="true">
                      <use xlink:href="#info-circle"></use>
                    </svg>
                    <div class="optin-info-tooltip">
                      {{html-safe sub.description}}
                    </div>
                  </span>
                {{/if}}

                <OptinNotificationButton @category={{sub}} />
              </span>
            {{/each}}
          </div>
        {{/if}}
      </section>
    {{/each}}
  </div>
{{/if}}
